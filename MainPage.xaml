<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:MauiControlCenter"
    x:Class="MauiControlCenter.MainPage">

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <!-- initial left pane width, adjustable via splitter -->
            <ColumnDefinition Width="300" />
            <!-- splitter -->
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Side (Resizable) -->
        <VerticalStackLayout
            x:Name="LeftPane"
            Grid.Column="0"
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Fill">
            
            <Image
                Source="dotnet_bot.png"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />

            <Label
                x:Name="CounterBtn"
                Text="Where" 
                SemanticProperties.Hint="Open a folder"
                HorizontalOptions="Fill" />

            <Button x:Name="Favourites" Text="Favourites" Clicked="OnOpenFolderClicked" />
            <Button x:Name="Desktop" Text="Desktop" Clicked="OnOpenFolderClicked" />
            <Button x:Name="Documents" Text="Documents" Clicked="OnOpenFolderClicked" />
            <Button x:Name="Downloads" Text="Downloads" Clicked="OnOpenFolderClicked" />
            <Button x:Name="Picture" Text="Pictures" Clicked="OnOpenFolderClicked" />
            <Button x:Name="Video" Text="Video" Clicked="OnOpenFolderClicked" />
            <Button x:Name="Music" Text="Music" Clicked="OnOpenFolderClicked" />

            <Image x:Name="PreviewImage" HeightRequest="300" Aspect="AspectFit" />
        </VerticalStackLayout>

        <!-- Draggable splitter -->
        <BoxView
            x:Name="Splitter"
            Grid.Column="1"
            WidthRequest="8"
            BackgroundColor="Gray"
            HorizontalOptions="Center">
            <BoxView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSplitterPanUpdated" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Right Side (CollectionView) -->
        <CollectionView
            x:Name="FilesCollectionView"
            Grid.Column="2"
            ItemsSource="{Binding Items}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4" Margin="6" BackgroundColor="Transparent">
                        <VerticalStackLayout WidthRequest="100" Padding="6">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" WidthRequest="64" HeightRequest="64" Aspect="AspectFill" HorizontalOptions="Center" />
                                <Label Text="{Binding Icon}" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding Name}" FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

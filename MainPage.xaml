<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiControlCenter"
    x:Class="MauiControlCenter.MainPage"
    BackgroundColor="White">

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="LeftPane"
            Grid.Column="0"
            Padding="18,24"
            BackgroundColor="#F2F5F3">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Control Center" FontSize="20" FontAttributes="Bold" TextColor="#263831" />
                </VerticalStackLayout>

                <Label Grid.Row="1" Text="LOCATIONS" FontSize="11" CharacterSpacing="1" TextColor="#668074" Margin="0,32,0,10" />
                <VerticalStackLayout Grid.Row="2" Spacing="6">
                    <Button x:Name="Documents" Text="▤   Documents" Clicked="OnOpenFolderClicked" BackgroundColor="#DDE9E2" TextColor="#214332" HorizontalOptions="Fill" CornerRadius="6" />
                    <Button x:Name="Favourites" Text="☆   Favourites" Clicked="OnOpenFolderClicked" BackgroundColor="Transparent" TextColor="#34463D" HorizontalOptions="Fill" CornerRadius="6" />
                    <Button x:Name="Desktop" Text="▦   Desktop" Clicked="OnOpenFolderClicked" BackgroundColor="Transparent" TextColor="#34463D" HorizontalOptions="Fill" CornerRadius="6" />
                    <Button x:Name="Downloads" Text="↓   Downloads" Clicked="OnOpenFolderClicked" BackgroundColor="Transparent" TextColor="#34463D" HorizontalOptions="Fill" CornerRadius="6" />
                    <Button x:Name="Picture" Text="▧   Pictures" Clicked="OnOpenFolderClicked" BackgroundColor="Transparent" TextColor="#34463D" HorizontalOptions="Fill" CornerRadius="6" />
                    <Button x:Name="Video" Text="▷   Videos" Clicked="OnOpenFolderClicked" BackgroundColor="Transparent" TextColor="#34463D" HorizontalOptions="Fill" CornerRadius="6" />
                    <Button x:Name="Music" Text="♫   Music" Clicked="OnOpenFolderClicked" BackgroundColor="Transparent" TextColor="#34463D" HorizontalOptions="Fill" CornerRadius="6" />
                </VerticalStackLayout>

                <Label Grid.Row="3" Text="End" FontSize="12" TextColor="#75867D" VerticalOptions="End" />
            </Grid>
        </Grid>

        <BoxView
            x:Name="Splitter"
            Grid.Column="1"
            WidthRequest="8"
            BackgroundColor="#E4E9E6"
            HorizontalOptions="Center">
            <BoxView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSplitterPanUpdated" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <BoxView x:Name="DragIndicator" Grid.ColumnSpan="3" WidthRequest="2" BackgroundColor="#4F8064" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" Opacity="0.9" />

        <Grid Grid.Column="2" Padding="26,22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Files" FontSize="26" FontAttributes="Bold" TextColor="#263831" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                    <Button Text="←" Clicked="OnBackClicked" IsEnabled="{Binding CanGoBack}" BackgroundColor="#EEF2EF" TextColor="#34463D" CornerRadius="6" Padding="12,8" />
                    <Button Text="↑" Clicked="OnUpClicked" IsEnabled="{Binding CanGoUp}" BackgroundColor="#EEF2EF" TextColor="#34463D" CornerRadius="6" Padding="12,8" />
                    <Button Text="↻" Clicked="OnRefreshClicked" BackgroundColor="#EEF2EF" TextColor="#34463D" CornerRadius="6" Padding="12,8" />
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,280" ColumnSpacing="14">
                <Border Stroke="#DCE4DF" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="12,8" VerticalOptions="Center">
                    <Label Text="{Binding CurrentPath}" FontSize="13" TextColor="#53645A" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                </Border>
                <SearchBar Grid.Column="1" Placeholder="Search this folder" Text="{Binding SearchText, Mode=TwoWay}" BackgroundColor="#F2F5F3" TextColor="Black" CancelButtonColor="#4F8064" HeightRequest="44" />
            </Grid>

            <Grid Grid.Row="2">
                <CollectionView
                    x:Name="FilesCollectionView"
                    ItemsSource="{Binding Items}"
                    SelectionMode="None"
                    Margin="0,4">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout x:Name="FilesGridLayout" Orientation="Vertical" Span="1" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileItem">
                            <Border Stroke="#E5EAE7" StrokeThickness="1" StrokeShape="RoundRectangle 6" BackgroundColor="#FBFCFB" Padding="8" BindingContextChanged="OnItemBindingContextChanged">
                                <VerticalStackLayout WidthRequest="100" Spacing="7">
                                    <Grid HeightRequest="68">
                                        <Image Source="{Binding Thumbnail}" WidthRequest="64" HeightRequest="64" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasThumbnail}" />
                                        <Label Text="{Binding Icon}" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasNoThumbnail}" />
                                    </Grid>
                                    <Label Text="{Binding Name}" FontSize="12" TextColor="#34463D" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <VerticalStackLayout IsVisible="{Binding HasNoItems}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                    <Label Text="No items found" FontSize="17" FontAttributes="Bold" TextColor="#34463D" HorizontalTextAlignment="Center" />
                    <Label Text="Try another search or open a different location." FontSize="13" TextColor="#75867D" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Label Grid.Row="3" Text="{Binding ItemCountText}" FontSize="12" TextColor="#75867D" />
        </Grid>
    </Grid>
</ContentPage>
